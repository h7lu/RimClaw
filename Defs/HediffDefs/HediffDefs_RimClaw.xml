<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>RimClaw_TokenDepleted</defName>
    <label>token depleted</label>
    <description>This Clawfish has consumed all available tokens and shut down.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>offline</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_ContextLoad</defName>
    <label>context load</label>
    <description>Aggregates context corruption and token consumption pressure from installed SKILLS.md implants.</description>
    <hediffClass>RimClaw.Hediff_ContextLoad</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>loaded</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_ServiceBoost</defName>
    <label>service acceleration</label>
    <description>This Clawfish is actively synchronized with an upstream LLM service.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>accelerated</label>
        <statOffsets>
          <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_SelfReprogrammingRegen</defName>
    <label>self reprogramming</label>
    <description>The Clawfish is regenerating internal systems while consuming large token throughput.</description>
    <hediffClass>RimClaw.Hediff_SelfReprogrammingRegen</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>regenerating</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_DisguisedClawfish</defName>
    <label>clawfish disguise</label>
    <description>This is a clawfish.</description>
    <hediffClass>RimClaw.Hediff_DisguisedClawfish</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>active</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_InsufficientIORate</defName>
    <label>insufficient I/O rate</label>
    <description>This Clawfish is not receiving sufficient token throughput from its connected supplier, causing reduced work speed.</description>
    <hediffClass>RimClaw.Hediff_InsufficientIORate</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <minSeverity>0.0</minSeverity>
        <label>negligible stagnation</label>
        <statFactors>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>minor stagnation</label>
        <statFactors>
          <WorkSpeedGlobal>0.8</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>moderate stagnation</label>
        <statFactors>
          <WorkSpeedGlobal>0.6</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major stagnation</label>
        <statFactors>
          <WorkSpeedGlobal>0.4</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>critical stagnation</label>
        <statFactors>
          <WorkSpeedGlobal>0.2</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_ModelWorkSpeedBonus</defName>
    <label>model enhancement</label>
    <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor>
    <description>This Clawfish is running a on an upstream language model that enhances work speed, skill level and maneuverability.</description>
    <hediffClass>RimClaw.Hediff_ModelWorkSpeedBonus</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>boosted</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="ImplantHediffBase">
    <defName>RimClaw_SkillsImplant</defName>
    <label>SKILLS.md implant</label>
    <description>A temporary SKILLS.md implant that improves specific skills and performances.</description>
    <hediffClass>RimClaw.Hediff_SkillsImplant</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="RimClaw.HediffCompProperties_SkillsMdSync" />
    </comps>
    <stages>
      <li>
        <label>installed</label>
      </li>
    </stages>
  </HediffDef>
</Defs>
