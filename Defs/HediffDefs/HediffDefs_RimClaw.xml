<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>RimClaw_TokenDepleted</defName>
    <label>token depleted</label>
    <description>This Clawfish has consumed all available tokens and shut down.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>offline</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_ServiceBoost</defName>
    <label>service acceleration</label>
    <description>This Clawfish is actively synchronized with an upstream LLM service.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>accelerated</label>
        <statOffsets>
          <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_SelfReprogrammingRegen</defName>
    <label>self reprogramming</label>
    <description>The Clawfish is regenerating internal systems while consuming large token throughput.</description>
    <hediffClass>RimClaw.Hediff_SelfReprogrammingRegen</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>regenerating</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_DisguisedClawfish</defName>
    <label>clawfish disguise</label>
    <description>This colonist keeps a clawfish visual shell.</description>
    <hediffClass>RimClaw.Hediff_DisguisedClawfish</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>active</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RimClaw_InsufficientIORate</defName>
    <label>insufficient I/O rate</label>
    <description>This Clawfish is not receiving sufficient token throughput from its connected supplier, causing reduced work speed.</description>
    <hediffClass>RimClaw.Hediff_InsufficientIORate</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>throttled</label>
        <statOffsets>
          <WorkSpeedGlobal>-0.5</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
