<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>RimClaw_ModelCard</defName>
    <label>model package</label>
    <description>A data package containing the inferrence framework and full parameter of a Large Language Model. Install this on a memory disk of a datacenter to run locally.</description>
    <graphicData>
      <texPath>model</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <statBases>
      <MarketValue>2200</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <tradeability>All</tradeability>
    <techLevel>Spacer</techLevel>
    <comps>
      <li Class="RimClaw.CompProperties_ModelCard">
        <namePrefixes>
          <li>kwen</li>
          <li>clawdex</li>
          <li>omni</li>
          <li>rex</li>
          <li>delta</li>
        </namePrefixes>
        <nameSuffixes>
          <li>3.5_27b</li>
          <li>2.1_14b</li>
          <li>4.0_72b</li>
          <li>mini_8b</li>
        </nameSuffixes>
        <requiredVramMin>10</requiredVramMin>
        <requiredVramMax>60</requiredVramMax>
        <tokenPerSecondPerInstanceMin>80</tokenPerSecondPerInstanceMin>
        <tokenPerSecondPerInstanceMax>260</tokenPerSecondPerInstanceMax>
        <workSpeedBonusMin>-0.7</workSpeedBonusMin>
        <workSpeedBonusMax>0.02</workSpeedBonusMax>
        <inspectFormat>Model: {0}
Parameter size: {1:0.0}B
Required VRAM: {2} GB
Token/s per instance: {3:0.0}
Fee rate: x{4:0.00}
Work speed: x{5:0.00}
Skill level adjust: {6}</inspectFormat>
      </li>
    </comps>
  </ThingDef>
</Defs>
