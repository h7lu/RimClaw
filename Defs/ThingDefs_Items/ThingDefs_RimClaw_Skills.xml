<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>RimClaw_SkillsMd</defName>
    <label>SKILLS.md</label>
    <description>An open-standard Markdown file format implant that instructs AI agents on how to perform specific, specialized tasks. It includes metadata, instructions, and tools that allow agents to execute complex workflows, follow brand guidelines, or use external tools efficiently. Boosts the clawfish's ability in some specializations. Each SKILLS.md installed contribute to additional 5% token I/O consumption rate.</description>
