<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>RimClaw_PromptInjector</defName>
    <label>Prompt Injector</label>
    <description>Launches hostile prompt payloads that can force Clawfish behavioral collapse.</description>
    <graphicData>
      <texPath>Prompt_Injector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <Mass>6.5</Mass>
      <WorkToMake>1000</WorkToMake>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>2.4</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RimClaw_PromptInjectorProjectile</defaultProjectile>
        <warmupTime>0.7</warmupTime>
        <range>22.9</range>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <burstShotCount>1</burstShotCount>
        <targetParams>
          <canTargetLocations>false</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <canTargetFires>false</canTargetFires>
          <canTargetItems>false</canTargetItems>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetPawns>true</canTargetPawns>
        </targetParams>
      </li>
    </verbs>
    <weaponTags>
      <li>RangedHunting</li>
      <li>RimClawPromptInjector</li>
    </weaponTags>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RimClaw_PromptInjectorProjectile</defName>
    <label>prompt payload</label>
    <thingClass>RimClaw.Projectile_PromptInjector</thingClass>
    <graphicData>
      <texPath>PI_bullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.8,2)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>EMP</damageDef>
      <damageAmountBase>40</damageAmountBase>
      <speed>30</speed>
      <stoppingPower>0</stoppingPower>
    </projectile>
  </ThingDef>
</Defs>
