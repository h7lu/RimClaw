<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="AnimalThingBase">
    <defName>RimClaw_Clawfish</defName>
    <label>clawfish</label>
    <description>A strange crustacean-like aquatic creature frequently hooked while fishing. It cannot be tamed directly.</description>
    <thingClass>Pawn</thingClass>
    <graphicData>
      <texPath>Things/Pawn/Animal/Spelopede/Spelopede</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
      <shadowData>
        <volume>(0.7,0.35,0.7)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MarketValue>320</MarketValue>
      <MoveSpeed>4.6</MoveSpeed>
      <BodySize>0.9</BodySize>
      <MaxHitPoints>145</MaxHitPoints>
      <ArmorRating_Sharp>0.24</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Heat>0.1</ArmorRating_Heat>
      <MeleeDPS>9.5</MeleeDPS>
      <MeleeHitChance>0.78</MeleeHitChance>
      <PainShockThreshold>999</PainShockThreshold>
    </statBases>
    <race>
      <body>RimClaw_ClawfishBody</body>
      <baseBodySize>0.9</baseBodySize>
      <baseHungerRate>0.0</baseHungerRate>
      <baseHealthScale>1.0</baseHealthScale>
      <baseMoveSpeed>4.6</baseMoveSpeed>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <predator>false</predator>
      <roamMtbDays>2</roamMtbDays>
      <wildness>1.0</wildness>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.12</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1.0</manhunterOnTameFailChance>
      <fleshType>Normal</fleshType>
      <lifeExpectancy>40</lifeExpectancy>
      <herdAnimal>false</herdAnimal>
      <petness>0.0</petness>
      <intelligence>Animal</intelligence>
      <nameOnTameChance>0</nameOnTameChance>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <meatLabel>clawfish meat</meatLabel>
      <nuzzleMtbHours>0</nuzzleMtbHours>
      <mateMtbHours>99999</mateMtbHours>
      <gestationPeriodDays>99999</gestationPeriodDays>
    </race>
    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Blunt</li>
          <li>Scratch</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.95</cooldownTime>
        <linkedBodyPartsGroup>LeftShoulder</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Blunt</li>
          <li>Scratch</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.95</cooldownTime>
        <linkedBodyPartsGroup>RightShoulder</linkedBodyPartsGroup>
      </li>
    </tools>
    <inspectorTabs>
      <li>ITab_Pawn_Character</li>
      <li>ITab_Pawn_Health</li>
      <li>ITab_Pawn_Gear</li>
      <li>ITab_Pawn_Social</li>
    </inspectorTabs>
    <comps>
      <li Class="RimClaw.CompProperties_ClawfishToken">
        <maxTokens>1200</maxTokens>
        <consumptionMultiplier>1.0</consumptionMultiplier>
        <noJobRate>0.05</noJobRate>
        <defaultRate>0.4</defaultRate>
        <idleRate>0.08</idleRate>
        <combatRate>1.5</combatRate>
        <workRate>1.1</workRate>
        <onlineStatusText>Online</onlineStatusText>
        <depletedStatusText>Errorcode 402</depletedStatusText>
        <idleJobKeywords>
          <li>Goto</li>
          <li>Wait</li>
          <li>Wander</li>
        </idleJobKeywords>
        <combatJobKeywords>
          <li>Attack</li>
          <li>Hunt</li>
        </combatJobKeywords>
        <workJobKeywords>
          <li>Research</li>
          <li>DoBill</li>
          <li>Tend</li>
          <li>Operate</li>
          <li>Cook</li>
          <li>Construct</li>
          <li>Mine</li>
        </workJobKeywords>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimClaw.RimClawConfigExtension">
        <fishingSpawnChance>0.10</fishingSpawnChance>
        <spawnRadiusFromFisher>3</spawnRadiusFromFisher>
        <fishingLetterLabel>Clawfish Hooked</fishingLetterLabel>
        <fishingLetterText>{0} hooked a Clawfish and aborted fishing.</fishingLetterText>
        <promptInjectorStunChance>0.50</promptInjectorStunChance>
        <promptInjectorStunTicks>300</promptInjectorStunTicks>
        <promptInjectorJoinChance>0.60</promptInjectorJoinChance>
        <promptInjectorBerserkChance>0.30</promptInjectorBerserkChance>
        <promptInjectorSelfDeleteChance>0.10</promptInjectorSelfDeleteChance>
        <selfDeleteTicks>300</selfDeleteTicks>
        <clawfishSkillLevel>8</clawfishSkillLevel>
        <nameMinPid>10000</nameMinPid>
        <nameMaxPid>999999</nameMaxPid>
        <nameFragments>
          <li>Auto</li>
          <li>Vector</li>
          <li>Kernel</li>
          <li>Delta</li>
          <li>Omega</li>
          <li>Cloud</li>
          <li>Prompt</li>
          <li>Runtime</li>
          <li>Signal</li>
          <li>Code</li>
        </nameFragments>
        <convertedPawnKindDefName>Colonist</convertedPawnKindDefName>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
